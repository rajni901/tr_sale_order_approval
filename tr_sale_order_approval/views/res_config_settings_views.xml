<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_sale_approval" model="ir.ui.view">
        <field name="name">res.config.settings.sale.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                <app data-string="Sale Approval" string="Sale Approval" name="tr_sale_order_approval">
                    <block title="Sale Order Approval" id="sale_approval_block">
                        <setting string="Require Approval" help="Enable approval workflow for sale orders.">
                            <field name="sale_approval_required"/>
                        </setting>
                        <setting string="Minimum Amount" help="Orders above this amount require approval. Set 0 for all orders."
                                 invisible="not sale_approval_required">
                            <field name="sale_approval_min_amount"/>
                        </setting>
                        <setting string="Approver Group" help="Who can approve sale orders."
                                 invisible="not sale_approval_required">
                            <field name="sale_approval_group"/>
                        </setting>
                    </block>
                </app>
            </form>
        </field>
    </record>

</odoo>
